# Server settings. Copy to .env (git-ignored) and edit. Real environment variables win over this file.

# Defaults for NEW poker tables. Change any table's numbers live from the admin panel (localhost:5173/admin.html).
# Bots per table, 0-8.
OWL_DEFAULT_BOTS=4
# How many of those bots are AI (Claude) bots: a number or "all". 0 = all bots use the rule-based script.
OWL_LLM_BOTS=2
# Model the headless Claude Code CLI uses for bot decisions.
OWL_LLM_MODEL=claude-haiku-5-5
# A decision taking longer than this falls back to the script.
OWL_LLM_TIMEOUT_MS=15000
# Path to the Claude Code CLI if it isn't on PATH.
OWL_CLAUDE_BIN=claude

# PORT=3000
